[Unit]
Description=Create and verify a consistent game database backup
Requires=docker.service
After=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /app/rathena/tools/admin/database_backup.py --check-restore
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5min
