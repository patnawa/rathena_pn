# /db/
# Keep the runtime import directory ignored by default, but explicitly retain
# the episode fragments maintained by this repository.  Ignoring the entire
# directory made fresh clones silently omit required Episode 20, Thanatos, and
# legacy-quest databases even though an existing developer checkout worked.
/db/import/*
!/db/import/grademk_item_enchant.yml
!/db/import/grademk_service_enchants.yml
!/db/import/perfect_item_enchant.yml
!/db/import/episode20_instance_db.yml
!/db/import/episode20_mob_db.yml
!/db/import/episode20_mob_skill_db.txt
!/db/import/episode20_quest_db.yml
!/db/import/legacy_compat_quest_db.yml
!/db/import/thanatos_mob_db.yml
!/db/import/thanatos_mob_skill_db.txt
!/db/import/thanatos_quest_db.yml
!/db/import/enchant_repair.yml
!/db/import/enchant_repair_combos.yml
!/db/import/enchant_repair_items.yml
!/db/import/shadow_repair_items.yml
!/db/import/shadow_repair_laphine.yml
!/db/import/shadow_repair_options.yml

